#!/usr/bin/env python3
"""Follow the uConsole keyboard's active layer, for a waybar custom module.

The firmware prints "uconsole:layer N" on the QMK console (HID usage page
0xFF31) on every layer change and every few seconds. This script reads it and
prints one JSON line per change:

    {"text": "Fn", "alt": "fn", "class": "fn", "tooltip": "Keyboard layer 1: Fn"}

The base layer has an empty text, so waybar hides the module. While the
keyboard is missing, the class is "disconnected" and the text is empty.

Usage: uconsole-layer [NAME0 NAME1 ...]   (default: Base Fn Gamepad Free)

Needs read access to the keyboard's /dev/hidraw nodes (root, or a udev rule
for 434b:5543 with TAG+="uaccess").
"""
import glob
import json
import os
import re
import sys
import time

VID_PID = "0000434B:00005543"
CONSOLE_USAGE_PAGE = b"\x06\x31\xff"  # report descriptor: Usage Page (0xFF31)
MESSAGE = re.compile(rb"uconsole:layer (\d+)")
RETRY_SECONDS = 2


def find_console():
    for node in glob.glob("/sys/class/hidraw/hidraw*"):
        try:
            with open(node + "/device/uevent") as f:
                uevent = f.read()
            with open(node + "/device/report_descriptor", "rb") as f:
                descriptor = f.read()
        except OSError:
            continue
        if VID_PID in uevent and descriptor.startswith(CONSOLE_USAGE_PAGE):
            return "/dev/" + os.path.basename(node)
    return None


def emit(text, css_class, tooltip):
    print(json.dumps({"text": text, "alt": css_class, "class": css_class, "tooltip": tooltip}), flush=True)


def follow(device, names):
    """Print layer changes until the device goes away."""
    current = None
    pending = b""
    with open(device, "rb", buffering=0) as console:
        while True:
            report = console.read(64)
            if not report:
                return
            # Console reports are NUL padded chunks of the printed text
            pending += report.rstrip(b"\0")
            *lines, pending = pending.split(b"\n")
            for line in lines:
                match = MESSAGE.search(line)
                if not match:
                    continue  # other console output (QMK debug)
                layer = int(match.group(1))
                if layer == current:
                    continue
                current = layer
                name = names[layer] if layer < len(names) else f"Layer {layer}"
                emit("" if layer == 0 else name, name.lower(), f"Keyboard layer {layer}: {name}")


def main():
    names = sys.argv[1:] or ["Base", "Fn", "Gamepad", "Free"]
    connected = None
    while True:
        device = find_console()
        if device is None:
            if connected is not False:
                emit("", "disconnected", "uConsole keyboard not found")
                connected = False
            time.sleep(RETRY_SECONDS)
            continue
        connected = True
        try:
            follow(device, names)
        except OSError:
            pass  # unplugged or reset (e.g. Fn+Fn): look for it again
        emit("", "disconnected", "uConsole keyboard not found")
        connected = False
        time.sleep(RETRY_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
