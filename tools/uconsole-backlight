#!/usr/bin/env python3
"""Get or set the uConsole keyboard backlight over the VIA protocol.

Usage: uconsole-backlight          print the current level (0-10)
       uconsole-backlight LEVEL    set the level (0 = off, 10 = max) and save it

Needs read/write access to the keyboard's /dev/hidraw node (root, or a udev
rule for 434b:5543 with TAG+="uaccess").
"""
import glob
import os
import sys

VID_PID = "0000434B:00005543"
VIA_USAGE_PAGE = b"\x06\x60\xff"  # report descriptor: Usage Page (0xFF60)
LEVELS = 10  # BACKLIGHT_LEVELS in config.h

# VIA commands on the QMK backlight channel
CUSTOM_SET_VALUE, CUSTOM_GET_VALUE, CUSTOM_SAVE = 0x07, 0x08, 0x09
BACKLIGHT_CHANNEL, BACKLIGHT_BRIGHTNESS = 0x01, 0x01


def find_device():
    for node in glob.glob("/sys/class/hidraw/hidraw*"):
        try:
            with open(node + "/device/uevent") as f:
                uevent = f.read()
            with open(node + "/device/report_descriptor", "rb") as f:
                descriptor = f.read()
        except OSError:
            continue
        if VID_PID in uevent and descriptor.startswith(VIA_USAGE_PAGE):
            return "/dev/" + os.path.basename(node)
    sys.exit("uConsole keyboard (434b:5543) with VIA not found")


def command(fd, *payload):
    # Report id 0 followed by the 32-byte raw HID packet
    os.write(fd, bytes([0, *payload]).ljust(33, b"\0"))
    return os.read(fd, 32)


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and not sys.argv[1].isdigit()):
        sys.exit(__doc__.strip())

    fd = os.open(find_device(), os.O_RDWR)
    try:
        if len(sys.argv) == 2:
            level = min(int(sys.argv[1]), LEVELS)
            # The firmware truncates value * LEVELS / 255, so round up
            value = (level * 255 + LEVELS - 1) // LEVELS
            command(fd, CUSTOM_SET_VALUE, BACKLIGHT_CHANNEL, BACKLIGHT_BRIGHTNESS, value)
            command(fd, CUSTOM_SAVE, BACKLIGHT_CHANNEL)
        else:
            reply = command(fd, CUSTOM_GET_VALUE, BACKLIGHT_CHANNEL, BACKLIGHT_BRIGHTNESS)
            print((reply[3] * LEVELS + 127) // 255)
    finally:
        os.close(fd)


if __name__ == "__main__":
    main()
